# Copy to .env and fill in. .env is gitignored and must never be committed.
DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/forkast
TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/forkast_test

# openssl rand -hex 32
JWT_SECRET=CHANGEME-generate-a-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30

DEFAULT_TIMEZONE=Asia/Karachi

# fake = deterministic local estimator, no network, no key needed.
# groq = the real API. Needs GROQ_API_KEY, and the app refuses to start
# without one so a missing key is not discovered on the first request.
AI_PROVIDER=fake
GROQ_API_KEY=
# Do not use llama-3.3-70b-versatile or llama-3.1-8b-instant: both were
# shut down on 2026-08-16 despite still appearing on the models page.
GROQ_MODEL=openai/gpt-oss-20b

CORS_ORIGINS=*
