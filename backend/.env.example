# Copy to .env and fill in. .env is gitignored and must never be committed.

# Mandatory: choose dev or production. production turns off /docs, /redoc and /openapi.json,
# which otherwise hand a stranger the whole route and schema list.
ENVIRONMENT=dev

DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/forkast
TEST_DATABASE_URL=postgresql+asyncpg://postgres:CHANGEME@localhost:5432/forkast_test

# openssl rand -hex 32
JWT_SECRET=CHANGEME-generate-a-random-32-byte-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFINE_RATE_LIMIT=60
LOG_DAILY_LIMIT=300
PHOTO_DAILY_LIMIT=100
RESTAURANT_DAILY_LIMIT=20

DEFAULT_TIMEZONE=Asia/Karachi

# fake = deterministic local estimator, no network, no key needed.
# groq = the real API. Needs GROQ_API_KEY, and the app refuses to start
# without one so a missing key is not discovered on the first request.
AI_PROVIDER=fake
GROQ_API_KEY=
# Do not use llama-3.3-70b-versatile or llama-3.1-8b-instant: both were
# shut down on 2026-08-16 despite still appearing on the models page.
GROQ_MODEL=openai/gpt-oss-20b

# Email verification uses the official Resend API. Create a key in the Resend
# dashboard and verify the sending domain before using its address below.
# Resend will reject senders on domains you have not verified.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Which Google OAuth clients this API will accept an ID token from, comma
# separated. One per platform: create an iOS client, an Android client and a
# Web client in the Google Cloud console and list all three, because the token
# the phone sends carries whichever client asked for it.
#
# Not a secret. An OAuth client id for a native app ships inside the bundle and
# anyone can read it out; what makes it safe is that the API refuses any token
# whose audience is not one of these. The client SECRET, if you are ever handed
# one, does not belong here or anywhere in this repo.
#
# Leave it empty to turn "Continue with Google" off. Empty means there is no
# audience to check against, so the route answers 503 and the app hides the
# button rather than offering one that cannot work.
GOOGLE_CLIENT_IDS=

CORS_ORIGINS=*

# Believe X-Forwarded-For when identifying a caller for rate limiting. Leave
# false unless a proxy you control is actually rewriting it: otherwise any
# caller can set the header and hand themselves a fresh allowance per request.
TRUST_PROXY_HEADERS=false

# How many proxies actually sit in front of the app. The header is read this
# many hops in FROM THE RIGHT, because proxies append and only the rightmost
# entries were written by something you control. 1 is right for a single nginx
# or load balancer; Cloudflare in front of a load balancer is 2. Too high walks
# left into whatever the caller sent.
TRUSTED_PROXY_HOPS=1

# Largest request body the API will read, in bytes. A food log is a few hundred.
MAX_REQUEST_BYTES=1048576

# Rate limits, per window, on the routes an attacker can reach for free.
# LOGIN_RATE_LIMIT is per address per peer, and catches guessing one account.
# LOGIN_PEER_RATE_LIMIT is per peer across all addresses, and catches a spray
# that tries one password against many accounts; higher, because an office
# behind one NAT address shares it.
# REFRESH_RATE_LIMIT is per peer for refresh calls, a separate bucket because a
# single mobile carrier or office can legitimately rotate many refresh tokens.
# REGISTER_RATE_LIMIT is per peer only, because enumeration uses a different
# address every time and a per-address key would never trip. It is intentionally
# higher than the login limit so a real burst of signups does not trip the
# anti-automation guard before the user can finish onboarding.
LOGIN_RATE_LIMIT=10
LOGIN_PEER_RATE_LIMIT=50
REFRESH_RATE_LIMIT=300
REGISTER_RATE_LIMIT=120
LOGIN_RATE_WINDOW_SECONDS=300

# Plan generation is the only route that costs real money once Groq is behind
# it, so it gets its own, longer window.
PLAN_RATE_LIMIT=20
PLAN_RATE_WINDOW_SECONDS=3600
