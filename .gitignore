# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
*.egg-info/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environment / secrets
.env
.env.local
*.local

# Node / Expo
node_modules/
.expo/
dist/
web-build/
*.tsbuildinfo
# jest --coverage writes here
coverage/

# OS
.DS_Store
Thumbs.db


# Agent scratch, never part of the project
.agents/
mobile/.agents/
mobile/.claude/
mobile/skills-lock.json
# playwright-cli writes snapshots, console logs and screenshots beside the
# project while a browser session is driving it.
.playwright-cli/
mobile/.playwright-cli/

# Editor settings are shared on purpose (see .vscode/settings.json): this is a
# monorepo with no root package.json, so without them an editor opened at the
# top level cannot resolve either half. Personal overrides go in the ignored
# file beside it.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.log
pytest_*out.txt