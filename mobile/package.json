      "components/**/*.{ts,tsx}",
      "hooks/**/*.{ts,tsx}",
      "lib/**/*.{ts,tsx}",
      "theme/**/*.{ts,tsx}",
      "!**/*.d.ts"
    ],
    "maxWorkers": 2
  },
  "engines": {
    "node": ">=22.13"
  }
